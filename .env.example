# Copy to .env (chmod 600). Never commit .env.
# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens)
HA_TOKEN=
# eBay Browse API, Production keyset from developer.ebay.com (optional; blocked at the
# "Marketplace account deletion" step, see docs/ROADMAP.md)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
