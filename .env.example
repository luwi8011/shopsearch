# Plain-Docker settings (docker-compose.yml). Copy to .env (chmod 600); never commit .env.
# The Home Assistant add-on sets these from its Configuration tab instead.
API_KEY=
LLM_URL=
LLM_MODEL=
ASSISTANT_NAME=Assistant
USER_PROFILE=
SEARXNG_URL=
DEFAULT_SITES=amazon,ebay
HOME_ZIP=
CRAIGSLIST_SITE=denver
FB_LOCATION=denver
LOCAL_RADIUS_MI=25
# Home Assistant: URL plus a long-lived access token (Profile -> Security)
HA_URL=
HA_TOKEN=
HA_NOTIFY=
HA_DASHBOARD=
# eBay Browse API, Production keyset from developer.ebay.com (optional)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
